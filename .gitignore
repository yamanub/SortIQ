# Python
__pycache__/
*.pyc
.venv/

# Local data, not source.
# data/: the photos are the user's own, backed up with the app's export
# models/: retrain via the Train flow or use the app's export bundle
# runs/: per-run decision logs and reject images
# gpu_jobs/: the trainer's GPU job folders
data/
models/
runs/
gpu_jobs/

# Installation-private AutoUndefined state. API keys live outside this tree.
var/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-wal
*.sqlite-shm
openai-key*

# Build output and scratch
*.zip
*.log
firmware/**/.pio/

*.sqlite3*
